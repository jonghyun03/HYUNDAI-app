# 로컬에서만 실행합니다. 외부 API로 음성을 보내지 않습니다.
PORT=8787
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# 비우면 macOS는 Yuna, Windows는 설치된 한국어 SAPI 음성을 선택합니다.
TTS_VOICE=
# 필요한 경우 실행 파일의 전체 경로. 따옴표는 .env 문법에 맞춰 사용하세요.
# PYTHON_BIN="C:/Users/example/AppData/Local/Programs/Python/Python312/python.exe"
# OLLAMA_BIN="C:/Users/example/AppData/Local/Programs/Ollama/ollama.exe"
# Firebase는 아직 연동되지 않았습니다. ID만 설정해도 연결되지는 않습니다.
FIREBASE_PROJECT_ID=
